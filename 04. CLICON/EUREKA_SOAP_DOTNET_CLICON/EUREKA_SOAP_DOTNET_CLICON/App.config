<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <appSettings>
    <!--
      Dirección del servidor SOAP (se arma http://SoapHost:SoapPuerto/SoapRuta).
      Cambie SoapHost por la IP de la PC del servidor (ipconfig) para trabajar en red.
      También se puede usar sin recompilar con las variables de entorno SOAP_HOST y SOAP_PORT.
    -->
    <add key="SoapHost" value="localhost" />
    <add key="SoapPuerto" value="8087" />
    <add key="SoapRuta" value="WSEureka.svc" />
  </appSettings>
</configuration>
